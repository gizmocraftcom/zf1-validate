{
    "name": "gizmocraft/zendframework1-validate",
    "description": "Zend Framework 1 Validate component",
    "type": "library",
    "keywords": [
        "framework",
        "zf1"
    ],
    "homepage": "http://framework.zend.com/",
    "license": "BSD-3-Clause",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "gizmocraft/zendframework1-exception": "^2.0.0",
        "gizmocraft/zendframework1-config": "^3.0.0",
        "gizmocraft/zendframework1-loader": "^2.0.0",
        "gizmocraft/zendframework1-registry": "^2.0.0",
        "gizmocraft/zendframework1-date": "^2.0.0",
        "gizmocraft/zendframework1-filter": "^2.0.0",
        "gizmocraft/zendframework1-locale": "^2.0.0",
        "gizmocraft/zendframework1-translate": "^2.0.0"
    },
    "autoload": {
        "psr-0": {
            "Zend_Validate_": "src/"
        },
        "classmap": [
            "src/Zend/Validate.php"
        ]
    },
    "autoload-dev": {
        "psr-0": {
            "Zend_": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.8",
        "phpstan/phpstan": "^2.3.7",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpro/grumphp-shim": "^2.27.2"
    },
    "include-path": [
        "src/"
    ],
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test-with-coverage": "phpunit --coverage-clover=clover.xml",
        "phpstan": "phpstan analyze -c phpstan.neon --no-progress --ansi --memory-limit=768M",
        "style-check": "php-cs-fixer fix --dry-run -vv"
    },
    "suggest": {
        "ext-iconv": "Used in Hostname and StringLength validators",
        "ext-ctype": "Used in the CreditCard and Hex validators",
        "ext-intl": "Optionally used in the EmailAddress validator",
        "gizmocraft/zendframework1-validate-db": "To use Zend_Db validations (RecordExists/NoRecordExists)",
        "gizmocraft/zendframework1-validate-ldap": "To use Zend_Ldap validations",
        "gizmocraft/zendframework1-validate-file": "To use Zend_File validations",
        "gizmocraft/zendframework1-validate-sitemap": "To use Zend_Sitemap validations"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp-shim": true
        }
    }
}
